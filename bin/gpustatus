#!/usr/bin/env python3
"""gpustatus — one JSON line describing what the GPU widget shows.

    {"present": true, "vendor": "NVIDIA", "name": "...", "load": 7,
     "memUsedMiB": 2129, "memTotalMiB": 8192, "tempC": 50, "powerW": 24.1,
     "clockMhz": 465, "fanPct": 0, "processes": [...], "gpus": [...]}

Prints {} when no GPU is readable — the widget hides itself. A key set to
null means "this driver doesn't report it" and hides that one row.
Standard library only. No root, no network.
"""

import importlib.machinery
import importlib.util
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))

# Importing the CLI in-process would otherwise litter the plugin folder with
# __pycache__; the plugin dir stays exactly as installed.
sys.dont_write_bytecode = True


def load_ctl():
    path = os.path.join(HERE, "gpuctl")
    loader = importlib.machinery.SourceFileLoader("gpuctl", path)
    spec = importlib.util.spec_from_loader("gpuctl", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def main():
    index = 0
    if len(sys.argv) > 1:
        try:
            index = int(sys.argv[1])
        except ValueError:
            index = 0
    try:
        ctl = load_ctl()
        state = ctl.get(index)
    except BaseException:  # never take the shell's Process down
        state = None
    if not state:
        print("{}")
        return
    sys.stdout.write(json.dumps(state) + "\n")


if __name__ == "__main__":
    main()
